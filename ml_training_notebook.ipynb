    {
      "cell_type": "code",
      "id": "cell-sql-3",
      "metadata": {"language": "sql"},
      "source": ["-- Window functions for feature engineering\nWITH raw_events AS (\n    SELECT \n        UNIFORM(1, 1000, RANDOM()) AS user_id,\n        UNIFORM(1, 50, RANDOM()) AS event_type,\n        DATEADD(second, -SEQ4(), CURRENT_TIMESTAMP()) AS event_time,\n        UNIFORM(1, 100, RANDOM()) AS event_value\n    FROM TABLE(GENERATOR(ROWCOUNT => 200000))\n)\nSELECT \n    user_id,\n    event_type,\n    event_value,\n    AVG(event_value) OVER (PARTITION BY user_id ORDER BY event_time ROWS BETWEEN       "ouING AND CURRENT ROW) AS rolling_avg,\n    LAG(event_value, 1) OVER (PARTITION BY user_id ORDER BY event_time) AS prev_value,\n    LEAD(event_value, 1) OVER (PARTITION BY user_id ORDER BY event_time) AS next_value,\n    ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY event_time DESC) AS recency_rank\nFROM raw_events\nQUALIFY recency_rank <= 5\nORDER BY user_id, recency_rank;"],
