      "source": ["# ML Training Notebook\n", "Simulates ML workload with heavy warehouse queries for feature engineering."]
    },
    {
      "cell_type": "code",
      "id": "cell-sql-1",
      "metadata": {"language": "sql"},
      "source": ["-- Feature engineering: heavy aggregation query\nWITH base_data AS (\n    SELECT \n        SEQ4() AS id,\n        UNIFORM(1, 100, RANDOM()) AS feature_1,\n        UNIFORM(1, 1000, RANDOM()) AS feature_2,\n        NORMAL(50, 10, RANDOM()) AS feature_3,\n        UNIFORM(0, 1, RANDOM()) AS label\n    FROM TABLE(GENERATOR(ROWCOUNT => 100000))\n)\nSELECT \n    MOD(id, 100) AS group_id,\n    AVG(feature_1) AS avg_f1,\n    STDDEV(feature_1) AS std_f1,\n    AVG(feature_2) AS avg_f2,\n    STDDEV(feature_2) AS std_f2,\n    AVG(feature_3) AS avg_f3,\n    VARIANCE(feature_3) AS var_f3,\n    COUNT(*) AS group_size,\n    SUM(label) AS positive_count\nFROM base_data\nGROUP BY group_id\nORDER BY group_id;"],
      "outputs": [],
      "execution_count": null
    },
    {
      "cell_type": "code",
      "id": "cell-sql-2",
      "metadata": {"language": "sql"},
      "source": ["-- Simulate joining multiple feature tables\nWITH customers AS (\n    SELECT SEQ4() AS customer_id, \n           UNIFORM(18, 80, RANDOM()) AS age,\n           UNIFORM(20000, 200000, RANDOM()) AS income\n    FROM TABLE(GENERATOR(ROWCOUNT => 50000))\n),\ntransactions AS (\n    SELECT \n        UNIFORM(1, 50000, RANDOM()) AS customer_id,\n        UNIFORM(1, 500, RANDOM()) AS amount,\n        DATEADD(day, -UNIFORM(0, 365, RANDOM()), CURRENT_DATE()) AS txn_date\n    FROM TABLE(GENERATOR(ROWCOUNT => 500000))\n)\nSELECT \n    c.customer_id,\n    c.age,\n    c.income,\n    COUNT(t.amount) AS txn_count,\n    SUM(t.amount) AS total_spend,\n    AVG(t.amount) AS avg_txn,\n    MAX(t.amount) AS max_txn,\n    DATEDIFF('day', MIN(t.txn_date), MAX(t.txn_date)) AS active_days\nFROM customers c\nLEFT JOIN transactions t ON c.customer_id = t.customer_id\nGROUP BY 1, 2, 3\nORDER BY total_spend DESC\nLIMIT 10000;"],
      "outputs": [],
      "execution_count": null
    },
